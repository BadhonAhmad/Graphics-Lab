{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenGL Circle Demo",
            "type": "shell",
            "command": "gcc",
            "args": [
                "circle_demo.c",
                "-o",
                "circle_demo.exe",
                "-Ifreeglut/freeglut/include",
                "-Lfreeglut/freeglut/lib",
                "-lopengl32",
                "-lglu32",
                "-lfreeglut",
                "-lwinmm",
                "-lgdi32"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build and Run OpenGL Circle Demo",
            "type": "shell",
            "command": "gcc circle_demo.c -o circle_demo.exe -Ifreeglut/freeglut/include -Lfreeglut/freeglut/lib -lopengl32 -lglu32 -lfreeglut -lwinmm -lgdi32; if ($?) { Copy-Item freeglut/freeglut/bin/freeglut.dll . -Force; ./circle_demo.exe }",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run OpenGL Circle Demo",
            "type": "shell",
            "command": "./circle_demo.exe",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
