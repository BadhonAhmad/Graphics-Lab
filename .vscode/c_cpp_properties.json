{
  "configurations": [
    {
      "name": "windows-gcc-x86",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/freeglut/freeglut/include"
      ],
      "compilerPath": "C:/MinGW/bin/gcc.exe",
      "cStandard": "c99",
      "cppStandard": "${default}",
      "intelliSenseMode": "windows-gcc-x86",
      "compilerArgs": [
        "-Ifreeglut/freeglut/include",
        "-Lfreeglut/freeglut/lib"
      ]
    }
  ],
  "version": 4
}